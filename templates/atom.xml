{% import "macros.html" as macros %}

{# Retain scalar URLs, not page-bearing taxonomy objects, in feed context.
   Resolve only kinds actually used by this feed, using Zola's native URL and
   missing-taxonomy semantics. Do not construct routes from taxonomy names. #}
{%- set_global feed_taxonomy_names = [] -%}
{%- set_global feed_taxonomy_urls = [] -%}
{%- for feed_page in pages -%}
    {%- for name, terms in feed_page.taxonomies -%}
        {%- if terms and name not in feed_taxonomy_names -%}
            {%- set native_url = get_taxonomy(kind=name, required=true) | get(key="permalink") -%}
            {%- set_global feed_taxonomy_names = feed_taxonomy_names | concat(with=name) -%}
            {%- set_global feed_taxonomy_urls = feed_taxonomy_urls | concat(with=native_url) -%}
        {%- endif -%}
    {%- endfor -%}
{%- endfor -%}

<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang }}">
    <title>{{ config.title }}
    {%- if term %} - {{ term.name }}
    {%- elif section.title %} - {{ section.title }}
    {%- endif -%}
    </title>
    {%- if config.description %}
    <subtitle>{{ config.description }}</subtitle>
    {%- endif %}
    <link href="{{ feed_url | safe }}" rel="self" type="application/atom+xml"/>
    <link rel="alternate" type="text/html" href="
      {%- if term -%}
        {{ term.permalink | escape_xml | safe }}
      {%- elif section -%}
        {{ section.permalink | escape_xml | safe }}
      {%- else -%}
        {{ config.base_url | escape_xml | safe }}
      {%- endif -%}
    "/>
    <generator uri="https://www.getzola.org/">Zola</generator>
    <updated>{{ last_updated | date(format="%+") }}</updated>
    <id>{{ feed_url | safe }}</id>
    {%- for page in pages %}
    <entry xml:lang="{{ page.lang }}">
        <title>{{ page.title }}</title>
        <published>{{ page.date | date(format="%+") }}</published>
        <updated>{{ page.updated | default(value=page.date) | date(format="%+") }}</updated>
	{% if page.extra.author_details %}
	{% for author in page.extra.author_details %}
	<author>
		<name>{{ author.name }}</name>
		{%- if author.github -%}
		<uri>https://github.com/{{ author.github }}</uri>
		{%- endif -%}
		{%- if author.email -%}
		<email>{{ author.email }}</email>
		{%- endif %}
	</author>
	{% endfor %}
	{% elif page.authors %}
	{% for author in page.authors %}
	<author><name>{{ author }}</name></author>
	{% endfor %}
	{% else %}
        <author>
          <name>
            {%- if config.author -%}
              {{ config.author }}
            {%- else -%}
              Unknown
            {%- endif -%}
          </name>
        </author>
	{% endif %}
        <link rel="alternate" href="{{ page.permalink | safe }}" type="text/html"/>
        {% if page.extra.discussions_to %}
        {# "replies" is defined in RFC 4685 #}
        <link rel="replies" type="text/html" href="{{ page.extra.discussions_to | escape_xml | safe }}" />
        {% endif %}

        <id>{{ page.permalink | safe }}</id>
        {% for taxonomy, terms in page.taxonomies %}
            {% set_global taxonomy_url = "" %}
            {% for name in feed_taxonomy_names %}
                {% if name == taxonomy %}
                    {% set_global taxonomy_url = feed_taxonomy_urls[loop.index0] %}
                {% endif %}
            {% endfor %}
            {% for term in terms | sort %}
            {% set term_slug = get_taxonomy_term(kind=taxonomy, term=term, required=true, include_pages=false) | get(key="slug") %}
            <category
                scheme="{{ taxonomy_url }}"
                term="{{ term_slug }}"
                label="{{ term | escape_xml | safe }}" />
            {% endfor %}
        {% endfor %}

        {% if page.extra.number %}
        <category
            term="tag:eip:{{ page.extra.number }}"
            label="{{ macros::eip_number(page=page) }}" />
        {% endif %}

        {# TODO: Number #}
        {# TODO: Slug Number (EIP-1234) #}

        {% if page.summary %}
        <summary type="html">{{ page.summary }}</summary>
        {% elif page.description %}
        <summary type="html">{{ page.description }}</summary>
        {% endif %}
        <content type="html"  xml:base="{{ page.permalink | escape_xml | safe }}">{{ page.content }}</content>
    </entry>
    {%- endfor %}
</feed>
