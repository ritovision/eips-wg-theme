#!/bin/sh

set -eu

say() {
    printf '%s\n' "$*"
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

absolute_path() {
    case "$1" in
        /*)
            printf '%s\n' "$1"
            ;;
        *)
            printf '%s/%s\n' "$INVOCATION_DIR" "$1"
            ;;
    esac
}

pick_writable_home_path_dir() {
    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        [ -d "$dir" ] || continue
        [ -w "$dir" ] || continue
        case "$dir" in
            "$HOME"|"$HOME"/*)
                printf '%s\n' "$dir"
                IFS=$old_ifs
                return 0
                ;;
        esac
    done
    IFS=$old_ifs
    return 1
}

pick_writable_path_dir() {
    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        [ -d "$dir" ] || continue
        [ -w "$dir" ] || continue
        printf '%s\n' "$dir"
        IFS=$old_ifs
        return 0
    done
    IFS=$old_ifs
    return 1
}

pick_install_dir() {
    if [ -n "${HOME:-}" ]; then
        if dir=$(pick_writable_home_path_dir); then
            printf '%s\n' "$dir"
            return 0
        fi

        dir=$HOME/.local/bin
        mkdir -p "$dir"
        if [ -w "$dir" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    fi

    pick_writable_path_dir
}

download() {
    url=$1
    destination=$2

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url" -o "$destination"
        return 0
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -qO "$destination" "$url"
        return 0
    fi

    die "need curl or wget to download release binaries"
}

ensure_install_dir() {
    [ -n "${INSTALL_DIR:-}" ] && return 0

    INSTALL_DIR=$(pick_install_dir) || die "could not find a writable install directory"
    case ":$PATH:" in
        *:"$INSTALL_DIR":*)
            ;;
        *)
            PATH=$INSTALL_DIR:$PATH
            PATH_NOTE=$INSTALL_DIR
            ;;
    esac
}

cleanup_tmpdir() {
    if [ -n "${TMPDIR_TO_CLEAN:-}" ]; then
        rm -rf "$TMPDIR_TO_CLEAN"
        TMPDIR_TO_CLEAN=
    fi
}

install_build_eips() {
    case "$(uname -s)" in
        Linux)
            archive_name=build-eips-ubuntu.tar.xz
            ;;
        Darwin)
            archive_name=build-eips-macos.tar.xz
            ;;
        *)
            die "unsupported operating system for automatic build-eips installation"
            ;;
    esac

    command -v tar >/dev/null 2>&1 || die "need tar to unpack the build-eips release archive"
    ensure_install_dir

    tmpdir=$(mktemp -d)
    TMPDIR_TO_CLEAN=$tmpdir
    trap cleanup_tmpdir EXIT INT TERM

    archive_path=$tmpdir/$archive_name
    release_url=https://github.com/eips-wg/preprocessor/releases/latest/download/$archive_name

    say "Installing build-eips from $release_url"
    download "$release_url" "$archive_path"
    tar -xf "$archive_path" -C "$tmpdir"
    [ -f "$tmpdir/build-eips" ] || die "release archive did not contain build-eips"

    cp "$tmpdir/build-eips" "$INSTALL_DIR/build-eips"
    chmod +x "$INSTALL_DIR/build-eips"

    BUILD_EIPS=$INSTALL_DIR/build-eips
    cleanup_tmpdir
}

WORKSPACE_FLAGS=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --template|--platform-dev)
            WORKSPACE_FLAGS="$WORKSPACE_FLAGS $1"
            ;;
        -h|--help)
            say "usage: $0 [--template] [--platform-dev]"
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
    shift
done

INVOCATION_DIR=$(pwd)
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
THEME_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
WORKSPACE_ROOT=$(CDPATH= cd -- "$THEME_ROOT/.." && pwd)
INSTALL_DIR=
PATH_NOTE=
TMPDIR_TO_CLEAN=

# Theme is not an active proposal repo, so workspace init is anchored through a
# sibling proposal repo. Default to EIPs and allow ERCs/custom layouts via env.
if [ -n "${ACTIVE_REPO_ROOT:-}" ]; then
    ACTIVE_REPO_ROOT=$(absolute_path "$ACTIVE_REPO_ROOT")
else
    ACTIVE_REPO_ROOT=$WORKSPACE_ROOT/EIPs
fi

if [ ! -d "$ACTIVE_REPO_ROOT" ]; then
    die "theme local setup needs an active proposal repo checkout such as EIPs at $ACTIVE_REPO_ROOT"
fi

ACTIVE_REPO_ROOT=$(CDPATH= cd -- "$ACTIVE_REPO_ROOT" && pwd)

if command -v build-eips >/dev/null 2>&1; then
    BUILD_EIPS=$(command -v build-eips)
    say "Using existing build-eips at $BUILD_EIPS"
else
    install_build_eips
fi

say "Theme repo: $THEME_ROOT"
say "Workspace root: $WORKSPACE_ROOT"
say "Active proposal repo: $ACTIVE_REPO_ROOT"

say "Bootstrapping workspace at $WORKSPACE_ROOT"
"$BUILD_EIPS" -C "$ACTIVE_REPO_ROOT" workspace init "$WORKSPACE_ROOT" $WORKSPACE_FLAGS

say "Running workspace doctor"
if ! "$BUILD_EIPS" -C "$ACTIVE_REPO_ROOT" workspace doctor; then
    say "Workspace doctor reported issues above. Fix them before relying on direct build-eips commands."
fi

say ""
say "Next commands:"
say "  cd $THEME_ROOT"
if [ -n "$PATH_NOTE" ]; then
    say "  export PATH=\"$PATH_NOTE:\$PATH\""
fi
say "  build-eips -C $ACTIVE_REPO_ROOT serve"
say "  build-eips -C $ACTIVE_REPO_ROOT check"
say "  build-eips -C $ACTIVE_REPO_ROOT workspace doctor"
